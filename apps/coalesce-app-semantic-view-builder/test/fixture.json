{
  "name": "SV_SAMPLE_SELFTEST",
  "location": "SAMPLE",
  "description": "Order lines with their orders and parts. It's a test of the builder's \"quoting\".",
  "spec": {
    "tables": [
      {
        "alias": "lines",
        "location": "TPCH",
        "node": "LINEITEM",
        "primaryKey": ["L_ORDERKEY", "L_LINENUMBER"],
        "synonyms": ["order lines", "line items"],
        "comment": "One row per order line."
      },
      {
        "alias": "orders",
        "location": "TPCH",
        "node": "ORDERS",
        "primaryKey": ["O_ORDERKEY"],
        "synonyms": ["sales orders"],
        "comment": "Orders"
      },
      {
        "alias": "parts",
        "location": "TPCH",
        "node": "PART",
        "primaryKey": ["P_PARTKEY"]
      }
    ],
    "relationships": [
      { "name": "lines_to_orders", "from": "lines", "fromColumns": ["L_ORDERKEY"], "to": "orders", "toColumns": ["O_ORDERKEY"] },
      { "name": "lines_to_parts", "from": "lines", "fromColumns": ["L_PARTKEY"], "to": "parts", "toColumns": ["P_PARTKEY"] }
    ],
    "facts": [
      { "table": "lines", "name": "list_price", "expr": "lines.L_EXTENDEDPRICE", "comment": "Quantity times the part's retail price" },
      { "table": "lines", "name": "net_price", "expr": "lines.L_EXTENDEDPRICE * (1 - lines.L_DISCOUNT)", "synonyms": ["discounted price"] }
    ],
    "dimensions": [
      { "table": "lines", "name": "ship_mode", "expr": "lines.L_SHIPMODE", "synonyms": ["carrier", "shipping method"], "comment": "How the line shipped" },
      { "table": "lines", "name": "ship_date", "expr": "lines.L_SHIPDATE" },
      { "table": "orders", "name": "order_priority", "expr": "orders.O_ORDERPRIORITY", "comment": "Order priority" },
      { "table": "orders", "name": "priority_label", "expr": "'P' || orders.O_ORDERPRIORITY" }
    ],
    "metrics": [
      { "table": "lines", "name": "total_list_price", "expr": "SUM(lines.list_price)", "synonyms": ["revenue"], "comment": "Total list price" },
      { "table": "lines", "name": "total_net_price", "expr": "SUM(lines.net_price)" },
      { "table": "lines", "name": "order_count", "expr": "COUNT(DISTINCT lines.L_ORDERKEY)" },
      { "table": "parts", "name": "part_count", "expr": "COUNT(parts.P_PARTKEY)" }
    ],
    "aiSqlGeneration": "Prices are in US dollars. Net price is after the line's discount.",
    "aiQuestionCategorization": "Reject questions that are not about orders.",
    "verifiedQueries": [
      {
        "name": "net_price_by_priority",
        "question": "What is total net price by order priority?",
        "sql": "SELECT * FROM SEMANTIC_VIEW(SV_SAMPLE_SELFTEST METRICS \"lines\".\"total_net_price\" DIMENSIONS \"orders\".\"order_priority\")",
        "onboarding": true,
        "verifiedAt": "1763856000",
        "verifiedBy": "analyst"
      }
    ]
  }
}
